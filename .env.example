# Banco (Postgres + pgvector)
POSTGRES_USER=kb
POSTGRES_PASSWORD=kb
POSTGRES_DB=kb
POSTGRES_PORT=5432
KB_DATABASE_URL=postgresql://kb:kb@localhost:5432/kb

# Ollama
OLLAMA_PORT=11434
KB_OLLAMA_URL=http://localhost:11434
KB_EMBEDDING_MODEL=bge-m3
# Modelo de geração: juiz de conflitos no relatório de saúde (e, depois, respostas)
KB_GENERATION_MODEL=qwen3:4b

# Reranker (Text Embeddings Inference)
RERANKER_PORT=8081
KB_RERANKER_URL=http://localhost:8081
# Precisa ser o modelo declarado em configs/pipelines/hibrida-rerank.yaml.
KB_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Pipeline de consulta padrão (arquivo em configs/pipelines/)
KB_PIPELINE=hibrida-rerank

# Chunking hierárquico: tamanho máximo de um chunk, em caracteres
KB_CHUNK_MAX_CHARS=1800

# Airflow (profile "airflow")
AIRFLOW_PORT=8080
AIRFLOW_JWT_SECRET=troque-este-segredo-local

# Painel de administração (profile "admin")
ADMIN_PORT=8501

# Relógio simulado: a "data de hoje" usada nas consultas e nos relatórios.
#   release    -> a data de referência da release para a qual a fonte aponta (demonstração)
#   AAAA-MM-DD -> uma data fixa
#   (vazio)    -> a data real
KB_DATA_SIMULADA=release
